{
  "expo": {
    "name": "Perfume Picks",
    "slug": "perfume-picks",
    "owner": "bg233",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perfumepicks",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bobguillow.perfumepicks",
      "appleTeamId": "ZNS5TNLB2D",
      "associatedDomains": ["applinks:perfumepicks.app"],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Perfume Picks needs access to your photo library so you can attach photos to your fragrance wardrobe and profile.",
        "NSPhotoLibraryAddUsageDescription": "Perfume Picks saves wardrobe photos to your library when you choose to keep them.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#171E2F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bobguillow.perfumepicks"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "cameraPermission": "Perfume Picks uses the camera so you can scan a bottle to identify the fragrance.",
        "photosPermission": "Perfume Picks needs access to your photos so you can attach images to your wardrobe and profile."
      }],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      ["@react-native-google-signin/google-signin", {
        "iosUrlScheme": "com.googleusercontent.apps.307052163679-qthrjn2865cin6devcg2re9dpmbrhfh5"
      }],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C4A35A",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5",
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45707459-d6b8-4aa8-8ddf-5a5894dde578"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/45707459-d6b8-4aa8-8ddf-5a5894dde578",
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
