{
  "name": "perfume-picks-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing the Perfume Picks fragrance database (13,000+ scents) as read-only tools for AI assistants. Search the catalog, find dupes, compare fragrances, and get wear suggestions — with citation-ready attribution.",
  "mcpName": "io.github.bguillow-rgb/perfume-picks",
  "type": "module",
  "bin": {
    "perfume-picks-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fragrance",
    "perfume",
    "cologne",
    "dupes",
    "scent",
    "perfume-picks"
  ],
