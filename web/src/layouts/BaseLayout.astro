---
import { SITE, NAV } from '../consts';
import OrganizationSchema from '../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  suppressGlobalSchema?: boolean;
}

const {
  title,
  description = SITE.description,
  path = '',
  noindex = false,
  suppressGlobalSchema = false,
} = Astro.props;

const canonical = `${SITE.url}${path}`;
const fullTitle =
  title === SITE.name ? `${SITE.name}, ${SITE.tagline}` : `${title}, ${SITE.name}`;

const currentPath = path;
---
<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="awin-site-verification" content="Awin" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {/* ?v=2 busts preview-crawler caches left over from the old placeholder-bottle icon */}
    <meta property="og:image" content={`${SITE.url}/icon-512.png?v=2`} />
    <meta name="twitter:image" content={`${SITE.url}/icon-512.png?v=2`} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="theme-color" content={SITE.theme.bg} />

    <!-- Google Fonts: Playfair Display (high-contrast fashion serif, display +
         wordmark) + Jost (geometric perfume-house sans, body + couture labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&display=optional"
      rel="stylesheet"
    />

    {!suppressGlobalSchema && <OrganizationSchema />}
    {!suppressGlobalSchema && <WebSiteSchema />}

    <Analytics />

    <slot name="head" />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a href="/" class="site-wordmark">{SITE.name}</a>
        <nav class="site-nav" aria-label="Main navigation">
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>
      </header>
      <div class="rule-jewel" aria-hidden="true"></div>
      <slot />
    </div>
    <!-- AI plugin attribution (2026-10-03): a visitor who arrives from one of our
         MCP servers' links (utm_medium=ai_plugin) keeps that source for the session,
         and App Store links on the site carry Apple campaign tags so App Store
         Connect credits the install to the assistant (pt = Timberline provider token). -->
    <script is:inline>
      (function () {
        try {
          var key = "tv_ai_src";
          var q = new URLSearchParams(location.search);
          if (q.get("utm_medium") === "ai_plugin") {
            sessionStorage.setItem(key, (q.get("utm_source") || "other").replace(/[^a-z0-9_-]/gi, "").slice(0, 20));
          }
          var src = sessionStorage.getItem(key);
          if (!src) return;
          var tag = function () {
            document.querySelectorAll('a[href*="apps.apple.com"]').forEach(function (a) {
              try {
                var u = new URL(a.href);
                if (u.searchParams.get("ct")) return;
                u.searchParams.set("pt", "128774733");
                u.searchParams.set("ct", ("ai-" + src + "-site").slice(0, 40));
                u.searchParams.set("mt", "8");
                a.href = u.toString();
              } catch (e) {}
            });
          };
          if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", tag);
          else tag();
        } catch (e) {}
      })();
    </script>
  </body>
</html>
