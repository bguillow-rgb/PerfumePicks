---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Page Not Found"
  description="That page does not exist on perfumepicks.app."
  path="/404"
  noindex={true}
>
  <p class="brand">{SITE.name}</p>
  <h1>This page evaporated</h1>
  <p class="effective">Nothing left on this note.</p>

  <p>
    Whatever was here has faded. Head back to the <a href="/">home page</a>,
    read the <a href="/articles">articles</a>, or see what the app does on the
    <a href="/features">features</a> page. Looking for something specific?
    <a href="/support">Support</a> can point you to it.
  </p>

  <Footer />
</BaseLayout>
