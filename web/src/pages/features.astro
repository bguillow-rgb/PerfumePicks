---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Features"
  description="What Perfume Picks does: a wardrobe with a remaining-mL meter, a wear log, Scent of the Day, Fragrance DNA, a dupe finder and Perfume Wrapped."
  path="/features"
>
  <Fragment slot="head">
    <BreadcrumbSchema crumbs={[{ name: 'Features', url: `${SITE.url}/features` }]} />
  </Fragment>

  <span class="eyebrow">{SITE.name}</span>
  <h1>Features</h1>
  <p class="effective">What the app does, screen by screen.</p>

  <!-- Morning Pick / Today -->
  <section class="feature-row">
    <div class="feature-row-copy">
      <span class="eyebrow">Scent of the Day</span>
      <h3>What should I wear today?</h3>
      <p>Every morning the app picks a bottle from your own wardrobe. It goes on your Fragrance DNA, the local weather, the occasion and what you haven&rsquo;t worn in a while, and it gives you one line on why.</p>
      <p>One tap logs the wear. You can turn on a daily reminder if you want one.</p>
    </div>
    <div class="feature-row-shot">
      <div class="device-wrap"><div class="device">
        <img
          src="/assets/screenshots/today.webp"
          alt="Perfume Picks Today screen showing a morning wear pick drawn from the user's wardrobe with weather context"
          loading="eager"
          width="260"
        />
      </div></div>
    </div>
  </section>

  <!-- Wardrobe -->
  <section class="feature-row feature-row--reverse">
    <div class="feature-row-shot">
      <div class="device-wrap"><div class="device">
        <img
          src="/assets/screenshots/wardrobe.webp"
          alt="Wardrobe screen showing fragrances by status, Have, Want, Worn, with mL tracking"
          loading="lazy"
          width="260"
        />
      </div></div>
    </div>
    <div class="feature-row-copy">
      <h3>Your wardrobe</h3>
      <p>Every bottle by house and family, marked <strong>Have</strong>, <strong>Want</strong> or <strong>Tested</strong>. A remaining-mL meter on each bottle drops as you log wears, and you can record what you paid.</p>
      <p>The free version holds 5 bottles. Pro has no limit.</p>
    </div>
  </section>

  <!-- Train My Nose -->
  <section class="feature-row">
    <div class="feature-row-copy">
      <span class="eyebrow">Fragrance DNA</span>
      <h3>Train My Nose</h3>
      <p>Tap up to five bottles you love and the app builds your Fragrance DNA from their accords and names your archetype. Train My Nose then shows you fragrances to swipe on, three a day on the free version, and the profile sharpens with every swipe and every wear you log.</p>
      <p>A taste profile screen shows the signals behind it.</p>
    </div>
    <div class="feature-row-shot">
      <div class="device-wrap"><div class="device">
        <img
          src="/assets/screenshots/train.webp"
          alt="Train My Nose swipe interface showing a fragrance card with Pass, Like, and Love actions"
          loading="lazy"
          width="260"
        />
      </div></div>
    </div>
  </section>

  <!-- Discover -->
  <section class="feature-row feature-row--reverse">
    <div class="feature-row-shot">
      <div class="device-wrap"><div class="device">
        <img
          src="/assets/screenshots/discover.webp"
          alt="Discover screen showing curated edits by mood, celebrity picks, and browse by house"
          loading="lazy"
          width="260"
        />
      </div></div>
    </div>
    <div class="feature-row-copy">
      <h3>Find your next bottle</h3>
      <p>Discover has curated edits by mood, Celebrity Picks, new arrivals and a browse by house, and you can compare two fragrances side by side.</p>
      <p>Every fragrance page has buy links to retailers. I may earn a small commission if you use one, and the price is the same.</p>
    </div>
  </section>

  <!-- Fragrance Detail -->
  <section class="feature-row">
    <div class="feature-row-copy">
      <span class="eyebrow">Fragrance Detail</span>
      <h3>Every note, every wear</h3>
      <p>Tap any fragrance to see its notes and accords, your own wear history and a private My Notes section. You can rate and review it, and read other people&rsquo;s reviews.</p>
      <p>Open the dupes on any fragrance to see cheaper bottles ranked by how close they smell, with what you&rsquo;d save. Free shows the closest one and Pro shows the rest.</p>
    </div>
    <div class="feature-row-shot">
      <div class="device-wrap"><div class="device">
        <img
          src="/assets/screenshots/fragrance-detail.webp"
          alt="Fragrance detail page showing The Queen's Room by Perfumehead with note pyramid and wear history"
          loading="lazy"
          width="260"
        />
      </div></div>
    </div>
  </section>

  <!-- Cost Per Wear + Wrapped -->
  <section class="feature-row feature-row--reverse">
    <div class="feature-row-shot">
      <div class="device-wrap"><div class="device">
        <img
          src="/assets/screenshots/today-edit.webp"
          alt="Today's Edit screen showing curated fragrance picks with new arrivals and trending in your taste"
          loading="lazy"
          width="260"
        />
      </div></div>
    </div>
    <div class="feature-row-copy">
      <h3>The wear log and Perfume Wrapped</h3>
      <p>Each wear records the date, the occasion, the weather, a rating and a note, and you can log a layered combination of two bottles. The free version keeps 10 wear logs.</p>
      <p>At the end of the year, <strong>Perfume Wrapped</strong> recaps your own wear log. It&rsquo;s a Pro feature.</p>
    </div>
  </section>

  <section class="cta-section">
    <h2 class="section-title" style="margin-top:0;">Try it</h2>
    <p class="cta-body">
      Perfume Picks is free on the App Store. Questions and feedback go to
      <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>, and I read every one.
    </p>
    <div class="cta-row">
      {SITE.appStoreUrl ? (
        <a class="btn" href={SITE.appStoreUrl}>Download on iOS</a>
      ) : (
        <span class="btn btn--disabled">App Store (Coming Soon)</span>
      )}
    </div>
  </section>

  <Footer />
</BaseLayout>
