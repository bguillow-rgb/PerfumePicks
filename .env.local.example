EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=your-revenuecat-apple-key
# Comped-Pro allowlist now lives in the `comped_users` table (migration 013).
# Seed entries via the Supabase SQL editor — never commit emails to source.
# Anthropic API key is server-side only — set via `npx supabase secrets set ANTHROPIC_API_KEY=...`
# Optional observability — leave empty to disable
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
# Local-only — needed for scripts that hit Supabase admin APIs (never ship to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App Store Connect (KPI dashboard) ──
# Sales & Trends is VENDOR-scoped. Perfume launched 2026-06-25, AFTER the
# entity migration from "Bob Guillow" (94212511, deprecated) to "Timberline
# Ventures LLC" (94462549), so all its sales live under the active vendor.
# The org-wide ASC API key + .p8 live in the pour-picks repo (shared).
ASC_KEY_ID=SNZ7M3M49Q
ASC_ISSUER_ID=your-issuer-uuid
ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_SNZ7M3M49Q.p8
ASC_VENDOR_NUMBER=94462549
