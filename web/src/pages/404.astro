---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
---
<BaseLayout
  title="Page Not Found"
  description="That page does not exist on perfumepicks.app."
  path="/404"
  noindex={true}
>
  <p class="brand">{SITE.name}</p>
  <h1>Page not found</h1>
  <p class="effective">There&rsquo;s nothing at this address.</p>

  <p>
    Try the <a href="/">home page</a>, the <a href="/articles">articles</a> or
    the <a href="/features">features</a> page. If a link on this site brought
    you here, <a href="/support">let me know</a> and I&rsquo;ll fix it.
  </p>

  <Footer />
</BaseLayout>
