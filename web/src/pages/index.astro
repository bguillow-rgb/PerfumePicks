---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import SoftwareApplicationSchema from '../components/schema/SoftwareApplicationSchema.astro';
import { SITE } from '../consts';
import { splitTitle } from '../lib/title';

// Latest 3 published articles for the homepage "From the Blog" teaser.
// Drafts are excluded automatically because they have published:false.
const latestArticles = (
  await getCollection('articles', ({ data }) => data.published)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const quickAnswer =
  'Perfume Picks is an iPhone app I built for keeping track of a fragrance ' +
  'collection. It files the bottles you own, logs each wear with the weather ' +
  'and the occasion, and picks something to wear each morning from your own ' +
  'wardrobe. A short taste picker builds your Fragrance DNA, and a dupe finder ' +
  'shows cheaper bottles that smell close. It doesn\'t sell fragrance.';

const faqs = [
  {
    q: 'What is Perfume Picks?',
    a:
      'It\'s an iPhone app I built to keep track of a fragrance wardrobe. You file the bottles you own, log each wear, and every morning the app picks a Scent of the Day from your own wardrobe. A short taste picker learns what you like.',
  },
  {
    q: 'Is Perfume Picks a retailer?',
    a:
      'No. Perfume Picks doesn\'t sell fragrance. Fragrance pages have buy links to retailers, and I may earn a small commission if you use one. The price you pay is the same, and the Terms spell this out.',
  },
  {
    q: 'Is Perfume Picks free?',
    a:
      'Yes. The free version holds 5 bottles, 5 label scans, 10 wear logs and 3 Train My Nose swipes a day, and it shows the closest dupe for any fragrance. Pro is $2.99 a month or $24.99 a year, with a 7-day free trial. It removes those limits, unlocks the full dupes list and adds Perfume Wrapped. Apple handles billing, and you can cancel any time in iOS Settings.',
  },
  {
    q: 'How does the wear log work?',
    a:
      'Open a fragrance and tap Log a Wear. You set the date, the occasion, the weather and a rating, and you can add a note. Each wear drops the bottle\'s remaining-mL meter. You can also log a layered combination of two bottles.',
  },
  {
    q: 'How does Scent of the Day work?',
    a:
      'Each morning the app picks a bottle from your wardrobe. It goes on your Fragrance DNA, the local weather, the occasion and what you haven\'t worn lately, and it gives you one line on why. One tap logs the wear.',
  },
  {
    q: 'Is my wardrobe data private?',
    a:
      'Yes. Your wardrobe, wear log, ratings and notes are tied to your account. I don\'t sell them or use them for advertising. The Privacy Policy covers what the community Scent of the Day feed shows.',
  },
  {
    q: 'Will there be an Android version?',
    a:
      'Not yet. Perfume Picks is iPhone only for now.',
  },
];
---
<BaseLayout
  title={SITE.name}
  description={SITE.description}
  path="/"
  full
>
  <Fragment slot="head">
    <SoftwareApplicationSchema />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:image" content={`${SITE.url}/icon.png`} />
  </Fragment>

  <section class="hero-wrap tuck">
    <div class="hero hero-lg">
      <div class="hero-body">
        <p class="eyebrow">Fragrance wardrobe &middot; iOS</p>
        <h1 class="t-welcome">Wear what you already own.</h1>
        <p class="intro">Perfume Picks files the bottles you own, logs each wear, and every morning <b>picks something from your own wardrobe</b> based on the weather and what you haven&rsquo;t worn lately. A short taste picker learns what you like, and a <b>dupe finder shows cheaper bottles that smell close</b>.</p>
        <div class="actions">
          <a class="btn" href={SITE.appStoreUrl}>Download free on the App Store</a>
        </div>
        <p class="fine">Free on iPhone. There are no ads.</p>
      </div>
      <div class="hero-phones" aria-label="Perfume Picks on iPhone">
        <img src="/app/8_fragrance-detail.webp" alt="A fragrance detail page in Perfume Picks with notes, accords and a buy link" width="1284" height="2778" fetchpriority="high" />
        <img src="/app/1_home.webp" alt="The Perfume Picks home screen showing your Fragrance DNA archetype" width="1284" height="2778" fetchpriority="high" />
        <img src="/app/9_concierge.webp" alt="Perfume Concierge, which identifies a fragrance from a photo of the bottle" width="1284" height="2778" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="contained gallery">
    <div class="intro-block">
      <p class="upper-tag">Features</p>
      <h2>What it does</h2>
      <QuickAnswer text={quickAnswer} label="" />
    </div>
    <div class="scroller" id="tiles">
      <article class="tile">
        <div class="media"><img src="/app/4_wardrobe.webp" alt="The myWardrobe screen in Perfume Picks, filtered by Have, Want and Tried" loading="lazy" /></div>
        <p class="caption"><b>Your wardrobe, filed.</b> Every bottle by house and family, marked Have, Want or Tested, with how much is left in it and what you paid.</p>
      </article>
      <article class="tile">
        <div class="media"><img src="/app/7_community.webp" alt="Community Scent of the Day, what other collectors are wearing today" loading="lazy" /></div>
        <p class="caption"><b>A wear log.</b> Tap to log a wear with the date, the occasion, the weather and a rating. The bottle&rsquo;s remaining-mL meter drops as you go.</p>
      </article>
      <article class="tile">
        <div class="media"><img src="/app/2_scent-of-the-day.webp" alt="Scent of the Day, a pick from your own wardrobe with a line on why it fits today" loading="lazy" /></div>
        <p class="caption"><b>Scent of the Day.</b> A pick from your own wardrobe each morning, with a line on why it fits today.</p>
      </article>
      <article class="tile">
        <div class="media"><img src="/app/5_taste-session.webp" alt="A Train My Nose taste session, swiping pass, like or love on a fragrance" loading="lazy" /></div>
        <p class="caption"><b>Fragrance DNA.</b> Tap the bottles you love and swipe through Train My Nose. The profile sharpens with every wear you log.</p>
      </article>
    </div>
    <div class="paddles">
      <a class="more" href="/features" style="margin-right:auto;align-self:center">See every feature &#8250;</a>
      <button type="button" aria-label="Previous" onclick="document.getElementById('tiles').scrollBy({left:-480,behavior:'smooth'})">&#8249;</button>
      <button type="button" aria-label="Next" onclick="document.getElementById('tiles').scrollBy({left:480,behavior:'smooth'})">&#8250;</button>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained split">
    <div class="split-copy">
      <p class="upper-tag">Fragrance DNA</p>
      <h2>Your taste, named.</h2>
      <p class="intro">Tap the scents you love and Perfume Picks reads them into a <b>Fragrance DNA archetype</b>. It sharpens every time you log a wear or swipe in Train My Nose.</p>
      <p class="names">The Signature Wearer, The Smart Shopper and The Connoisseur are three of them.</p>
    </div>
    <div class="bento">
      <div class="shot tall"><img src="/app/6_pick-the-ones-you-love.webp" alt="Pick the ones you love, the taste picker that seeds your Fragrance DNA" loading="lazy" /></div>
      <div class="shot"><img src="/app/1_home.webp" alt="Your Fragrance DNA on the home screen: The Signature Wearer" loading="lazy" /></div>
      <div class="shot"><img src="/app/5_taste-session.webp" alt="A taste session in Train My Nose" loading="lazy" /></div>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained split split--reverse">
    <div class="split-copy">
      <p class="upper-tag">Budget dupes</p>
      <h2>Cheaper bottles that smell close</h2>
      <p class="intro">Open any fragrance and Perfume Picks lists its dupes, ranked by how close they smell, with <b>what you&rsquo;d save, usually 30 to 70%</b>.</p>
      <p class="intro">The free version shows the closest dupe. Pro shows the rest of the list.</p>
    </div>
    <div class="shot wide"><img src="/app/3_dupes.webp" alt="Budget Dupes in Perfume Picks: two cheaper matches for Creed Aventus with the match score and the saving" loading="lazy" /></div>
  </section>

  <hr class="section-rule" />

  <section class="contained sticky-section">
    <div class="sticky-copy">
      <p class="upper-tag">Pro</p>
      <h2>How does Perfume Picks make money?</h2>
    </div>
    <div class="sticky-body">
      <p class="intro">
        Perfume Picks is <b>free to download</b>. Pro is $2.99 a month or $24.99 a
        year, with a 7-day free trial. It removes the free limits, unlocks the full
        dupes list and adds Perfume Wrapped, a yearly recap of your own wears.
        Fragrance pages also have buy links to retailers, and I may earn a small
        commission if you use one. <b>There are no ads, and I don&rsquo;t sell your
        data.</b>
      </p>
      {SITE.appStoreUrl ? (
        <a class="btn" href={SITE.appStoreUrl}>Download on iOS</a>
      ) : (
        <span class="btn btn--disabled">App Store (Coming Soon)</span>
      )}
    </div>
  </section>

  <hr class="section-rule" />

  {latestArticles.length > 0 && (
    <section class="contained sticky-section">
      <div class="sticky-copy">
        <p class="upper-tag">Blog</p>
        <h2>From the Blog</h2>
        <p>Articles on building and wearing a collection.</p>
        <a class="more" href="/articles">All articles &#8250;</a>
      </div>
      <div class="post-grid">
        {latestArticles.map((a) => {
          const [head, rest] = splitTitle(a.data.title);
          return (
            <a class="post-tile" href={`/articles/${a.slug}`}>
              <time>{a.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
              <span class="post-title">{head}</span>
              {rest && <span class="post-sub">{rest}</span>}
              <span class="more">Read it &#8250;</span>
            </a>
          );
        })}
        <a class="post-tile" href="/features">
          <time>Features</time>
          <span class="post-title">See every feature</span>
          <span class="post-sub">Wardrobe catalog, wear log, taste profile, weather-aware morning picks, cost-per-wear, Perfume Wrapped, and the SOTD feed.</span>
          <span class="more">Features &#8250;</span>
        </a>
      </div>
    </section>
  )}

  <hr class="section-rule" />

  <section class="contained sticky-section">
    <div class="sticky-copy">
      <p class="upper-tag">FAQ</p>
      <h2>Frequently Asked Questions</h2>
    </div>
    <FAQ faqs={faqs} heading="" />
  </section>

  <Footer />
</BaseLayout>
