---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import SoftwareApplicationSchema from '../components/schema/SoftwareApplicationSchema.astro';
import { SITE } from '../consts';
import { splitTitle } from '../lib/title';

// Latest 3 published articles for the homepage "From the Blog" teaser.
// Drafts are excluded automatically because they have published:false.
const latestArticles = (
  await getCollection('articles', ({ data }) => data.published)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const quickAnswer =
  'Perfume Picks is an iOS app for fragrance collectors. Catalog every bottle ' +
  'you own, log each wear with the weather and occasion, and get morning picks ' +
  'drawn from your wardrobe, not from a store. A taste profile, cost-per-wear, ' +
  'and an annual Perfume Wrapped recap are built in. Perfume Picks is not a ' +
  'retailer; we never sell fragrance.';

const faqs = [
  {
    q: 'What is Perfume Picks?',
    a:
      'Perfume Picks is an iOS app for fragrance collectors. You catalog your wardrobe, log every wear, and get weather- and occasion-aware picks from the bottles you already own. A taste profile is built from your real collection, not just a quiz.',
  },
  {
    q: 'Is Perfume Picks a retailer?',
    a:
      'No. Perfume Picks does not sell fragrance. When you want to buy a bottle, the app links out to retailers like FragranceX, Sephora, or Amazon Luxury Beauty. We may earn a small commission on those links at no cost to you, and this is disclosed in the Terms.',
  },
  {
    q: 'Is Perfume Picks free? What does Pro unlock?',
    a:
      'The app is free to download. Free gives you the basic taste quiz, a limited daily round of Train My Nose swipes, and a wardrobe of up to twenty bottles. Pro unlocks the full quiz, unlimited swipes, the taste profile screen, advanced analytics, cost-per-wear, and Perfume Wrapped. Pro is monthly or yearly, managed through Apple, and cancelable anytime in iOS Settings.',
  },
  {
    q: 'How does the wear log work?',
    a:
      'Tap a fragrance you wore today and confirm. The app records the date, captures local weather automatically, and asks you for occasion and how many sprays. You can backdate up to two years, log multiple fragrances on the same day for layering experiments, and search wears by season, occasion, or fragrance family later on.',
  },
  {
    q: 'Is my wardrobe data private?',
    a:
      'Yes. Your wardrobe, wear log, ratings, and notes are private by default. Nothing is shared, sold, or used for cross-user ad targeting. Scent of the Day posts become public only when you flip the toggle on a specific entry. See the Privacy Policy for the full breakdown.',
  },
  {
    q: 'Will there be an Android version?',
    a:
      'Perfume Picks launches on iOS first. An Android release is on the roadmap but not yet scheduled.',
  },
  {
    q: 'Why an app instead of a website?',
    a:
      'A wardrobe lives in your pocket. Logging a wear should take three taps from a notification, not a desktop login. The phone also gives us camera-based bottle entry, local weather, and the kind of quick swipe interface that builds a real taste profile over time.',
  },
];
---
<BaseLayout
  title={SITE.name}
  description={SITE.description}
  path="/"
  full
>
  <Fragment slot="head">
    <SoftwareApplicationSchema />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:image" content={`${SITE.url}/icon.png`} />
  </Fragment>

  <section class="hero-wrap tuck">
    <div class="hero hero-lg">
      <div class="hero-body">
        <p class="eyebrow">Fragrance wardrobe &middot; iOS</p>
        <h1 class="t-welcome">The collector&rsquo;s wardrobe.</h1>
        <p class="intro">Catalog every bottle, <b>log each wear</b> with the weather and occasion, and get morning picks <b>drawn from the fragrances you already own</b>, never from a store. Wear what you love.</p>
        <div class="actions">
          <a class="btn" href={SITE.appStoreUrl}>Download free on the App Store</a>
        </div>
        <p class="fine">No ads. Your wardrobe stays yours. iOS first.</p>
      </div>
      <div class="hero-phones" aria-label="Perfume Picks on iPhone">
        <img src="/app/8_fragrance-detail.webp" alt="A fragrance detail page in Perfume Picks with notes, accords and a buy link" width="1284" height="2778" fetchpriority="high" />
        <img src="/app/1_home.webp" alt="The Perfume Picks home screen showing your Fragrance DNA archetype" width="1284" height="2778" fetchpriority="high" />
        <img src="/app/9_concierge.webp" alt="Perfume Concierge, which identifies a fragrance from a photo of the bottle" width="1284" height="2778" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="contained gallery">
    <div class="intro-block">
      <p class="upper-tag">Features</p>
      <h2>Built for collectors</h2>
      <QuickAnswer text={quickAnswer} label="" />
    </div>
    <div class="scroller" id="tiles">
      <article class="tile">
        <div class="media"><img src="/app/4_wardrobe.webp" alt="The myWardrobe screen in Perfume Picks, filtered by Have, Want and Tried" loading="lazy" /></div>
        <p class="caption"><b>Your wardrobe, organized.</b> Every bottle by house, family, and status, owned, tried, want, empty. Remaining mL meter and purchase price tracked per bottle.</p>
      </article>
      <article class="tile">
        <div class="media"><img src="/app/7_community.webp" alt="Community Scent of the Day, what other collectors are wearing today" loading="lazy" /></div>
        <p class="caption"><b>A wear log that remembers.</b> Tap to log. Weather and occasion captured automatically. Backdate up to two years and log layering combinations on the same day.</p>
      </article>
      <article class="tile">
        <div class="media"><img src="/app/2_scent-of-the-day.webp" alt="Scent of the Day, a pick from your own wardrobe with a line on why it fits today" loading="lazy" /></div>
        <p class="caption"><b>Picks for tonight, not just shopping.</b> Morning pick suggests something from your wardrobe based on weather, occasion, and what you have not worn recently. The answer comes from your shelf, not a store.</p>
      </article>
      <article class="tile">
        <div class="media"><img src="/app/5_taste-session.webp" alt="A Train My Nose taste session, swiping pass, like or love on a fragrance" loading="lazy" /></div>
        <p class="caption"><b>A taste profile from your collection.</b> Swipe through scents to refine your profile, then watch it sharpen with every wear you log. Built from real behavior, not a five-question quiz.</p>
      </article>
    </div>
    <div class="paddles">
      <a class="more" href="/features" style="margin-right:auto;align-self:center">See every feature &#8250;</a>
      <button type="button" aria-label="Previous" onclick="document.getElementById('tiles').scrollBy({left:-480,behavior:'smooth'})">&#8249;</button>
      <button type="button" aria-label="Next" onclick="document.getElementById('tiles').scrollBy({left:480,behavior:'smooth'})">&#8250;</button>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained split">
    <div class="split-copy">
      <p class="upper-tag">Fragrance DNA</p>
      <h2>Your taste, named.</h2>
      <p class="intro">Tap the scents you love and Perfume Picks reads your palate into <b>one of eleven archetypes</b>. It is your taste, made legible, and it keeps sharpening every time you wear, swipe, and add a bottle.</p>
      <p class="names">The Connoisseur, The Seducer, The Purist, The Showstopper, The Smart Shopper, The Romantic, The Explorer, The Classicist, The Rebel, The Executive and The Signature Wearer.</p>
    </div>
    <div class="bento">
      <div class="shot tall"><img src="/app/6_pick-the-ones-you-love.webp" alt="Pick the ones you love, the taste picker that seeds your Fragrance DNA" loading="lazy" /></div>
      <div class="shot"><img src="/app/1_home.webp" alt="Your Fragrance DNA on the home screen: The Signature Wearer" loading="lazy" /></div>
      <div class="shot"><img src="/app/5_taste-session.webp" alt="A taste session in Train My Nose" loading="lazy" /></div>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained split split--reverse">
    <div class="split-copy">
      <p class="upper-tag">Budget dupes</p>
      <h2>Cheaper bottles that smell the same</h2>
      <p class="intro">Love a $300 bottle? Perfume Picks surfaces dupes that smell nearly identical, ranked by match and showing <b>what you save, often 30 to 70% less</b>. One find pays for a year.</p>
      <p class="intro">It is the most useful thing in the app, and the simplest reason collectors go Pro.</p>
    </div>
    <div class="shot wide"><img src="/app/3_dupes.webp" alt="Budget Dupes in Perfume Picks: two cheaper matches for Creed Aventus with the match score and the saving" loading="lazy" /></div>
  </section>

  <hr class="section-rule" />

  <section class="contained sticky-section">
    <div class="sticky-copy">
      <p class="upper-tag">Pro</p>
      <h2>How does Perfume Picks make money?</h2>
    </div>
    <div class="sticky-body">
      <p class="intro">
        Perfume Picks is <b>free to download</b>. A Pro subscription unlocks the full
        taste quiz, unlimited Train My Nose swipes, the taste profile screen,
        advanced analytics, and Perfume Wrapped. Some fragrance detail pages also
        include &ldquo;Buy from&rdquo; links to retailers like FragranceX, Sephora,
        and Amazon Luxury Beauty, we may earn a small commission when you
        use one, at no cost to you. <b>There are no ads and no data selling.</b> We do
        not sell fragrance.
      </p>
      {SITE.appStoreUrl ? (
        <a class="btn" href={SITE.appStoreUrl}>Download on iOS</a>
      ) : (
        <span class="btn btn--disabled">App Store (Coming Soon)</span>
      )}
    </div>
  </section>

  <hr class="section-rule" />

  {latestArticles.length > 0 && (
    <section class="contained sticky-section">
      <div class="sticky-copy">
        <p class="upper-tag">Blog</p>
        <h2>From the Blog</h2>
        <p>Field-tested references for fragrance collectors.</p>
        <a class="more" href="/articles">All articles &#8250;</a>
      </div>
      <div class="post-grid">
        {latestArticles.map((a) => {
          const [head, rest] = splitTitle(a.data.title);
          return (
            <a class="post-tile" href={`/articles/${a.slug}`}>
              <time>{a.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
              <span class="post-title">{head}</span>
              {rest && <span class="post-sub">{rest}</span>}
              <span class="more">Read it &#8250;</span>
            </a>
          );
        })}
        <a class="post-tile" href="/features">
          <time>Features</time>
          <span class="post-title">See every feature</span>
          <span class="post-sub">Wardrobe catalog, wear log, taste profile, weather-aware morning picks, cost-per-wear, Perfume Wrapped, and the SOTD feed.</span>
          <span class="more">Features &#8250;</span>
        </a>
      </div>
    </section>
  )}

  <hr class="section-rule" />

  <section class="contained sticky-section">
    <div class="sticky-copy">
      <p class="upper-tag">FAQ</p>
      <h2>Frequently Asked Questions</h2>
    </div>
    <FAQ faqs={faqs} heading="" />
  </section>

  <Footer />
</BaseLayout>
