---
import BaseLayout from './BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ArticleSchema from '../components/schema/ArticleSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  path: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  quickAnswer: string;
  faqs: { q: string; a: string }[];
  // True when the article body contains retailer affiliate links. Renders
  // the disclosure above the body (FTC wants it before the links, not in
  // the footer) and turns on outbound click tracking.
  affiliate?: boolean;
  // Section label shown in breadcrumb between Home and the article (e.g.
  // \u201CGuides\u201D, \u201CHumidor\u201D). Optional.
  section?: { name: string; url: string };
}

const {
  title,
  description,
  path,
  publishedAt,
  updatedAt,
  author,
  quickAnswer,
  faqs,
  affiliate = false,
  section,
} = Astro.props;

const fullUrl = `${SITE.url}${path}`;
const crumbs = [
  ...(section ? [section] : []),
  { name: title, url: fullUrl },
];

const formattedDate = (updatedAt ?? publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={title} description={description} path={path}>
  <Fragment slot="head">
    <ArticleSchema
      title={title}
      description={description}
      url={fullUrl}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      author={author}
    />
    <BreadcrumbSchema crumbs={crumbs} />
  </Fragment>

  <header class="article-head">
    <p class="article-kicker">{section?.name ?? 'Journal'}</p>
    <h1>{title}</h1>
    <p class="article-dek">{description}</p>
    <p class="article-byline">
      By <a href="/about">{author}</a> &middot; {updatedAt ? 'Updated' : 'Published'} {formattedDate}
    </p>
  </header>

  <QuickAnswer text={quickAnswer} />

  {affiliate && (
    <p class="aff-disclosure">
      If you buy through a retailer link in this article, Perfume Picks earns a commission. Prices don't change because of it, and retailers don't choose the picks.
    </p>
  )}

  <div class="article-body">
    <slot />
  </div>

  <FAQ faqs={faqs} />

  <Footer />

  {affiliate && (
    <script is:inline>
      // Outbound affiliate click event → GA4. Mirrors the app's
      // affiliate_outbound_clicked event name so reporting can union them;
      // the platform dimension separates web from app.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[data-buy]');
        if (!a || typeof window.gtag !== 'function') return;
        window.gtag('event', 'affiliate_outbound_clicked', {
          retailer: a.getAttribute('data-retailer') || '',
          fragrance: a.getAttribute('data-buy') || '',
          article: window.location.pathname,
          platform: 'web',
        });
      });
    </script>
  )}
</BaseLayout>

<style is:global>
  .aff-disclosure {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--taupe);
    border-left: 2px solid var(--line2);
    padding-left: 14px;
    margin: 22px 0 0;
    max-width: 42em;
  }
  .buy-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px 18px;
    margin: 18px 0 26px;
  }
  .buy-card p { margin: 0; }
  .buy-name { font-weight: 600; color: var(--ink); }
  .buy-meta {
    font-size: 13.5px;
    color: var(--taupe);
    margin-top: 2px !important;
  }
  .buy-card a[data-buy] {
    flex: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--gold);
    padding: 10px 16px;
    border: 1px solid var(--gold-bright);
    border-radius: 8px;
    white-space: nowrap;
    border-bottom-width: 1px;
  }
  .buy-card a[data-buy]:hover { background: var(--ivory2); }
</style>
