---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import SoftwareApplicationSchema from '../components/schema/SoftwareApplicationSchema.astro';
import { SITE } from '../consts';

// Latest 3 published articles for the homepage "From the Blog" teaser.
// Drafts are excluded automatically because they have published:false.
const latestArticles = (
  await getCollection('articles', ({ data }) => data.published)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const quickAnswer =
  'Perfume Picks is an iOS app for fragrance collectors. Catalog every bottle ' +
  'you own, log each wear with the weather and occasion, and get morning picks ' +
  'drawn from your wardrobe, not from a store. A taste profile, cost-per-wear, ' +
  'and an annual Perfume Wrapped recap are built in. Perfume Picks is not a ' +
  'retailer; we never sell fragrance.';

const faqs = [
  {
    q: 'What is Perfume Picks?',
    a:
      'Perfume Picks is an iOS app for fragrance collectors. You catalog your wardrobe, log every wear, and get weather- and occasion-aware picks from the bottles you already own. A taste profile is built from your real collection, not just a quiz.',
  },
  {
    q: 'Is Perfume Picks a retailer?',
    a:
      'No. Perfume Picks does not sell fragrance. When you want to buy a bottle, the app links out to retailers like FragranceX, Sephora, or Amazon Luxury Beauty. We may earn a small commission on those links at no cost to you, and this is disclosed in the Terms.',
  },
  {
    q: 'Is Perfume Picks free? What does Pro unlock?',
    a:
      'The app is free to download. Free gives you the basic taste quiz, a limited daily round of Train My Nose swipes, and a wardrobe of up to twenty bottles. Pro unlocks the full quiz, unlimited swipes, the taste profile screen, advanced analytics, cost-per-wear, and Perfume Wrapped. Pro is monthly or yearly, managed through Apple, and cancelable anytime in iOS Settings.',
  },
  {
    q: 'How does the wear log work?',
    a:
      'Tap a fragrance you wore today and confirm. The app records the date, captures local weather automatically, and asks you for occasion and how many sprays. You can backdate up to two years, log multiple fragrances on the same day for layering experiments, and search wears by season, occasion, or fragrance family later on.',
  },
  {
    q: 'Is my wardrobe data private?',
    a:
      'Yes. Your wardrobe, wear log, ratings, and notes are private by default. Nothing is shared, sold, or used for cross-user ad targeting. Scent of the Day posts become public only when you flip the toggle on a specific entry. See the Privacy Policy for the full breakdown.',
  },
  {
    q: 'Will there be an Android version?',
    a:
      'Perfume Picks launches on iOS first. An Android release is on the roadmap but not yet scheduled.',
  },
  {
    q: 'Why an app instead of a website?',
    a:
      'A wardrobe lives in your pocket. Logging a wear should take three taps from a notification, not a desktop login. The phone also gives us camera-based bottle entry, local weather, and the kind of quick swipe interface that builds a real taste profile over time.',
  },
];
---
<BaseLayout
  title={SITE.name}
  description={SITE.description}
  path="/"
>
  <Fragment slot="head">
    <SoftwareApplicationSchema />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:image" content={`${SITE.url}/icon.png`} />
  </Fragment>

  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Fragrance wardrobe &middot; iOS</p>
      <h1>The collector&rsquo;s <em>wardrobe.</em></h1>
      <p class="hero-tagline">Catalog every bottle, log each wear with the weather and occasion, and get morning picks drawn from the fragrances you already own, never from a store. Wear what you love.</p>

      <a class="badge" href={SITE.appStoreUrl}>Download free on the App Store &rarr;</a>

      <p class="hero-trust">
        <span>No ads</span>
        <span>Your wardrobe stays yours</span>
        <span>iOS first</span>
      </p>
    </div>

    <aside class="hero-media" aria-label="Perfume Picks app, Today screen">
      <div class="device-wrap">
        <div class="device">
          <img
            src="/assets/screenshots/today.webp"
            alt="Perfume Picks Today screen showing a morning wear pick drawn from your wardrobe with weather context"
            width="286"
            height="570"
            loading="eager"
          />
        </div>
        <span class="float-chip float-chip--tl"><span class="star">&#9733;</span> The Connoisseur</span>
        <span class="float-chip float-chip--br">Taste match <strong>96</strong></span>
      </div>
    </aside>
  </section>

  <div class="pillars">
    <div class="pillar">
      <div class="pillar-num">I</div>
      <h3>Organized</h3>
      <p>Every bottle in one place, by house, family, and status.</p>
    </div>
    <div class="pillar">
      <div class="pillar-num">II</div>
      <h3>Remembered</h3>
      <p>A wear log that captures the weather and the occasion.</p>
    </div>
    <div class="pillar">
      <div class="pillar-num">III</div>
      <h3>Worn</h3>
      <p>A daily pick from your shelf, not from a store.</p>
    </div>
    <div class="pillar">
      <div class="pillar-num">IV</div>
      <h3>Understood</h3>
      <p>A Fragrance DNA built from what you actually love.</p>
    </div>
  </div>

  <QuickAnswer text={quickAnswer} />

  <!-- Fragrance DNA, the signature feature, given a dark editorial moment -->
  <section class="band band--ink">
    <div class="band-inner">
      <div class="dna-grid">
        <div class="dna-copy">
          <p class="eyebrow">Fragrance DNA</p>
          <h2>Your taste, <em>named.</em></h2>
          <p>Tap the scents you love and Perfume Picks reads your palate into one of eleven archetypes. It is your taste, made legible, and it keeps sharpening every time you wear, swipe, and add a bottle.</p>
          <ul class="dna-chips" aria-label="The eleven Fragrance DNA archetypes">
            <li class="is-lit">The Connoisseur</li>
            <li>The Seducer</li>
            <li>The Purist</li>
            <li>The Showstopper</li>
            <li>The Smart Shopper</li>
            <li>The Romantic</li>
            <li>The Explorer</li>
            <li>The Classicist</li>
            <li>The Rebel</li>
            <li>The Executive</li>
            <li>The Signature Wearer</li>
          </ul>
        </div>
        <div class="dna-media">
          <div class="device-wrap">
            <div class="device">
              <img
                src="/assets/screenshots/train.webp"
                alt="Train My Nose swipe interface that teaches Perfume Picks your taste"
                width="286"
                height="579"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <h2 class="section-title">Built for collectors</h2>

    <div class="feature-grid">
      <div class="feature">
        <div class="feature-icon" aria-hidden="true">I</div>
        <h3>Your wardrobe, organized</h3>
        <p>Every bottle by house, family, and status, owned, tried, want, empty. Remaining mL meter and purchase price tracked per bottle.</p>
      </div>

      <div class="feature">
        <div class="feature-icon" aria-hidden="true">II</div>
        <h3>A wear log that remembers</h3>
        <p>Tap to log. Weather and occasion captured automatically. Backdate up to two years and log layering combinations on the same day.</p>
      </div>

      <div class="feature">
        <div class="feature-icon" aria-hidden="true">III</div>
        <h3>Picks for tonight, not just shopping</h3>
        <p>Morning pick suggests something from your wardrobe based on weather, occasion, and what you have not worn recently. Wear what you own.</p>
      </div>

      <div class="feature">
        <div class="feature-icon" aria-hidden="true">IV</div>
        <h3>A taste profile from your collection</h3>
        <p>Swipe through scents to refine your profile, then watch it sharpen with every wear you log. Built from real behavior, not a five-question quiz.</p>
      </div>
    </div>

    <p class="features-link"><a href="/features">See every feature &rarr;</a></p>
  </section>

  <!-- Dupes, the value hook -->
  <section class="band band--ivory2">
    <div class="band-inner">
      <div class="split-grid split-grid--reverse">
        <div class="split-media">
          <div class="device-wrap">
            <div class="device">
              <img
                src="/assets/screenshots/fragrance-detail.webp"
                alt="A fragrance detail page in Perfume Picks showing the note pyramid, wear history, and cheaper dupes"
                width="286"
                height="583"
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <div class="split-copy">
          <p class="eyebrow">Budget dupes</p>
          <h2>Cheaper bottles that smell the same</h2>
          <p>Love a <span class="price-strike">$300</span> bottle? Perfume Picks surfaces dupes that smell nearly identical, ranked by match and showing what you save, <span class="price-now">often 30&ndash;70% less</span>.<span class="save-pill">one find pays for a year</span></p>
          <p>It is the most useful thing in the app, and the simplest reason collectors go Pro.</p>
        </div>
      </div>
    </div>
  </section>

  <h2>How does Perfume Picks make money?</h2>
  <p>
    Perfume Picks is free to download. A Pro subscription unlocks the full
    taste quiz, unlimited Train My Nose swipes, the taste profile screen,
    advanced analytics, and Perfume Wrapped. Some fragrance detail pages also
    include &ldquo;Buy from&rdquo; links to retailers like FragranceX, Sephora,
    and Amazon Luxury Beauty, we may earn a small commission when you
    use one, at no cost to you. There are no ads and no data selling. We do
    not sell fragrance.
  </p>

  <div class="cta-row">
    {SITE.appStoreUrl ? (
      <a class="btn" href={SITE.appStoreUrl}>Download on iOS</a>
    ) : (
      <span class="btn btn--disabled">App Store (Coming Soon)</span>
    )}
  </div>

  {latestArticles.length > 0 && (
    <section class="blog-teaser">
      <h2 class="section-title">From the Blog</h2>
      <ul class="blog-list">
        {latestArticles.map((a) => (
          <li>
            <a href={`/articles/${a.slug}`}>{a.data.title}</a>
            <p>{a.data.description}</p>
          </li>
        ))}
      </ul>
      <p class="features-link"><a href="/articles">All articles &rarr;</a></p>
    </section>
  )}

  <FAQ faqs={faqs} />

  <Footer />
</BaseLayout>
