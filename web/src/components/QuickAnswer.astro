---
// Quick Answer block. The single most important AEO element on a content
// page: 40-60 words that directly answer the page’s target query.
// Marked id="quick-answer" so Speakable schema (in ArticleSchema.astro)
// can point at it. Pass label="" to run it as a plain intro paragraph.
interface Props {
  text: string;
  label?: string;
}
const { text, label = 'Quick Answer' } = Astro.props;
---
<section class="quick-answer" id="quick-answer">
  {label && <span class="label">{label}</span>}
  <p>{text}</p>
</section>
