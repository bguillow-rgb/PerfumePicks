---
import { SITE, FOOTER_NAV } from '../consts';
const year = new Date().getFullYear();
---
<hr class="footer-rule" />
<nav class="footer-nav" aria-label="Footer navigation">
  {FOOTER_NAV.map((item) => (
    <a href={item.href}>{item.label}</a>
  ))}
</nav>
<p class="footer">
  Perfume Picks is an independent journal app. We do not sell fragrance.
  &ldquo;Buy from&rdquo; links to retailers may earn us a small commission
  at no cost to you.
</p>
<p class="footer">
  Questions? <a href={`mailto:${SITE.supportEmail}`} style="color:inherit;border-bottom:none;">{SITE.supportEmail}</a>
</p>
<p class="footer">&copy; {year} {SITE.name}, a {SITE.legalEntity} product. All rights reserved.</p>
<p class="footer">
  <a href="https://findly.tools/perfume-picks?utm_source=perfume-picks" target="_blank" rel="noopener">
    <img src="https://findly.tools/badges/findly-tools-badge-light.svg" alt="Featured on Findly.tools" width="150" height="52" loading="lazy" />
  </a>
</p>
