---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  // In dev mode, include drafts so you can preview unpublished article
  // skeletons. In production builds, drafts are excluded so bracketed
  // placeholder content never ships.
  const includeDrafts = import.meta.env.DEV;
  const all = await getCollection('articles', ({ data }) =>
    includeDrafts ? true : data.published
  );
  return all.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const path = `/articles/${entry.slug}`;

// Resolve related slugs to real article titles (never render a raw slug), and
// drop any that don't resolve to a live article so a related link can't 404.
const includeRelatedDrafts = import.meta.env.DEV;
const allArticles = await getCollection('articles', ({ data }) =>
  includeRelatedDrafts ? true : data.published
);
const titleBySlug = new Map(allArticles.map((a) => [a.slug, a.data.title]));
const related = (data.relatedSlugs ?? [])
  .filter((slug) => titleBySlug.has(slug))
  .map((slug) => ({ slug, title: titleBySlug.get(slug)! }));
---
<ArticleLayout
  title={data.title}
  description={data.description}
  path={path}
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  author={data.author}
  quickAnswer={data.quickAnswer}
  faqs={data.faqs}
  section={{ name: 'Articles', url: `${SITE.url}/articles` }}
>
  <Content />

  {related.length > 0 && (
    <section>
      <h2>Keep reading</h2>
      <ul class="blog-list">
        {related.map(({ slug, title }) => (
          <li><a href={`/articles/${slug}`}>{title}</a></li>
        ))}
      </ul>
    </section>
  )}
</ArticleLayout>
