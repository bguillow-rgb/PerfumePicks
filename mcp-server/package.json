  "license": "MIT",
  "homepage": "https://perfumepicks.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bguillow-rgb/perfume-picks-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/postgrest-js": "^2.109.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
