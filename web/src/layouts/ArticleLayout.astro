---
import BaseLayout from './BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ArticleSchema from '../components/schema/ArticleSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  path: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  quickAnswer: string;
  faqs: { q: string; a: string }[];
  // True when the article body contains retailer affiliate links. Renders
  // the disclosure above the body (FTC wants it before the links, not in
  // the footer) and turns on outbound click tracking.
  affiliate?: boolean;
  // Section label shown in breadcrumb between Home and the article (e.g.
  // “Guides”, “Humidor”). Optional.
  section?: { name: string; url: string };
  // H2 headings for the "On this page" column.
  headings?: { slug: string; text: string }[];
}

const {
  title,
  description,
  path,
  publishedAt,
  updatedAt,
  author,
  quickAnswer,
  faqs,
  affiliate = false,
  section,
  headings = [],
} = Astro.props;

const fullUrl = `${SITE.url}${path}`;
const crumbs = [
  ...(section ? [section] : []),
  { name: title, url: fullUrl },
];

const formattedDate = (updatedAt ?? publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={title} description={description} path={path} full>
  <Fragment slot="head">
    <ArticleSchema
      title={title}
      description={description}
      url={fullUrl}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      author={author}
    />
    <BreadcrumbSchema crumbs={crumbs} />
  </Fragment>

  <section class="hero-wrap tuck">
    <div class="hero hero-sm">
      <div class="hero-body">
        <p class="eyebrow"><a href="/articles">{section?.name ?? 'Blog'}</a></p>
        <h1 class="t-headline">{title}</h1>
        <p class="byline">By <a href="/about">{author}</a> &middot; {updatedAt ? 'Updated' : 'Published'} {formattedDate}</p>
      </div>
    </div>
  </section>

  <section class="contained sticky-section article-section">
    <aside class="sticky-copy toc">
      {headings.length > 0 && (
        <nav aria-label="On this page">
          <p class="upper-tag">On this page</p>
          {headings.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      )}
    </aside>
    <div class="article-main">
      <QuickAnswer text={quickAnswer} />

      {affiliate && (
        <p class="aff-disclosure">
          If you buy through a retailer link in this article, Perfume Picks earns a commission. Prices don't change because of it, and retailers don't choose the picks.
        </p>
      )}

      <div class="article-body">
        <slot />
      </div>

      <aside class="article-app-cta">
        <p class="article-app-lead">Perfume Picks learns what you like and tells you what to wear tonight. Free on iPhone.</p>
        <a class="btn" href={SITE.appStoreUrl}>Download free on the App Store</a>
      </aside>

      <FAQ faqs={faqs} />
    </div>
  </section>

  <Footer />

  {affiliate && (
    <script is:inline>
      // Outbound affiliate click event → GA4. Mirrors the app's
      // affiliate_outbound_clicked event name so reporting can union them;
      // the platform dimension separates web from app.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[data-buy]');
        if (!a || typeof window.gtag !== 'function') return;
        window.gtag('event', 'affiliate_outbound_clicked', {
          retailer: a.getAttribute('data-retailer') || '',
          fragrance: a.getAttribute('data-buy') || '',
          article: window.location.pathname,
          platform: 'web',
        });
      });
    </script>
  )}
</BaseLayout>
